# Telegram BotFather'dan alinan token
TELEGRAM_BOT_TOKEN=

# Google AI Studio'dan (aistudio.google.com) alinan Gemini API anahtari
GEMINI_API_KEY=

# Guvenlik: Sadece sizin Telegram kullanici ID'leriniz (virgul ile ayrilmis, orn: 123456789)
# Bos birakilirsa bot guvenlik geregi kimseye yanit vermez.
ALLOWED_TELEGRAM_USER_IDS=

# Opsiyonel: Kullanilacak Gemini modeli (varsayilan: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
